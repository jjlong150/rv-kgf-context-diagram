                "Mail Relay" [ shape="rectangle" height="1.125" width="1.125" fixedsize="True" gradientangle="90" fillcolor="White;0.85:#D9D9D9" color="#D9D9D9" fontname="Calibri" fontsize="10" style="filled" fontcolor="black" labelloc="top" image="images/system.png" imagescale="False" imagepos="bc" label="APP-10013\n\nMail Relay" tooltip="Mail Relay: A Simple Mail Transfer Protocol (SMTP) relay transfers email from one SMTP server to another over the internet until reaching the intended recipent." ];
            }
            subgraph "cluster_11" { penwidth="1" fillcolor="white" fontname="Calibri" fontsize="12" style="filled,rounded" labelloc="top" fontcolor="black" color="#B3B3B3" margin="12" label="Cloud Service Provider"
