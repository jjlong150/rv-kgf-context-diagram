            subgraph "cluster_6" { penwidth="1" fillcolor="white" fontname="Calibri" fontsize="12" style="filled,rounded" labelloc="top" fontcolor="black" color="#B3B3B3" margin="12" label="Information Technology"
                "System Administrator" [ labelloc="top" shape="rectangle" height="0.75" width="0.75" fixedsize="true" gradientangle="90" fillcolor="White;0.75:#B8CCE4" color="#B8CCE4" fontname="Calibri" fontsize="10" fontcolor="black" image="images/person.png" imagescale="False" imagepos="bc" style="filled,rounded" label="Person\nSystem\nAdministrator" tooltip="System Administrator: Administers the Consumer Notifications application, performing configuration, monitoring, and operational management tasks." ];
                "Note 4" [ shape="note" fixedsize="false" fillcolor="LemonChiffon1" color="DarkGoldenrod1" penwidth="0.5" fontname="Calibri" fontsize="12" style="filled" label="System Administrator creates\lemail templates in the\lMarketing CRM and catalogs\lthem in Consumer Notifications\lfor use.\l" tooltip="Note 4" ];
