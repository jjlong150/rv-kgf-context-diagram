                "Forward Proxy" [ shape="rectangle" height="1.125" width="1.125" fixedsize="True" gradientangle="90" fillcolor="White;0.85:#D9D9D9" color="#D9D9D9" fontname="Calibri" fontsize="10" style="filled" fontcolor="black" labelloc="top" image="images/system.png" imagescale="False" imagepos="bc" label="APP-10011\n\nForward\nProxy" tooltip="Forward Proxy: A type of proxy server that sits between a client and the internet, facilitating requests from the client to external servers." ];
