                "Credit Application System" [ shape="rectangle" height="1.125" width="1.125" fixedsize="true" gradientangle="90" fillcolor="White;0.85:#F79646" color="#F79646" fontname="Calibri" fontsize="10" style="filled" fontcolor="black" labelloc="top" image="images/homegrown.png" imagescale="False" imagepos="bc" label="APP-10004\n\nCredit\nApplication\nSystem" tooltip="Credit Application System: An in-house application used to process customer credit applications, assess creditworthiness, and manage credit risk." ];
                "Note 3" [ shape="note" fixedsize="false" fillcolor="LemonChiffon1" color="DarkGoldenrod1" penwidth="0.5" fontname="Calibri" fontsize="12" style="filled" label="An in-house application used\lto process customer credit\lapplications, assess\lcreditworthiness, and manage\lcredit risk.\l" tooltip="Note 3" ];
