            subgraph "cluster_7" { penwidth="1" fillcolor="white" fontname="Calibri" fontsize="12" style="filled,rounded" labelloc="top" fontcolor="black" color="#B3B3B3" margin="12" label="Marketing Department"
                "Campaign Owner" [ labelloc="top" shape="rectangle" height="0.75" width="0.75" fixedsize="true" gradientangle="90" fillcolor="White;0.75:#B8CCE4" color="#B8CCE4" fontname="Calibri" fontsize="10" fontcolor="black" image="images/person.png" imagescale="False" imagepos="bc" style="filled,rounded" label="Person\nCampaign\nOwner" tooltip="Campaign Owner: Defines the email campaign and supplies the distribution list." ];
                "Distribution List" [ shape="rectangle" height="0.625" width="0.75" fixedsize="true" fillcolor="transparent" color="transparent" fontcolor="black" fontname="Calibri" fontsize="10" style="filled" penwidth="0.5" image="images/file.png" imagescale="False" imagepos="bc" labelloc="top" label="Distribution\nList" tooltip="Distribution List: Contains email addresses and associated personalization values." ];
                "Note 5" [ shape="note" fixedsize="false" fillcolor="LemonChiffon1" color="DarkGoldenrod1" penwidth="0.5" fontname="Calibri" fontsize="12" style="filled" label="Campaign Owner uploads the\ltargeted customer distribution\llist, selects the email\ltemplate, and designates when\ldelivery should occur.\l" tooltip="Note 5" ];
