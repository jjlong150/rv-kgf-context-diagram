            subgraph "cluster_9" { penwidth="1" fillcolor="white" fontname="Calibri" fontsize="12" style="filled,rounded" labelloc="top" fontcolor="black" color="#B3B3B3" margin="12" label="Consumer's Home"
                "Email Client" [ shape="rectangle" height="1.125" width="1.125" fixedsize="True" gradientangle="90" fillcolor="White;0.85:#9BBB59" color="#9BBB59" fontname="Calibri" fontsize="10" style="filled" fontcolor="black" labelloc="top" image="images/opensource.png" imagescale="False" imagepos="bc" label="APP-10014\n\nEmail\nClient" tooltip="Email Client: A software application that allows users to access, compose, and send email messages. It acts as the interface between the user and the mail server. Also known as a Mail User Agent." ];
                Consumer [ labelloc="top" shape="rectangle" height="0.75" width="0.75" fixedsize="true" gradientangle="90" fillcolor="White;0.75:#B8CCE4" color="#B8CCE4" fontname="Calibri" fontsize="10" fontcolor="black" image="images/person.png" imagescale="False" imagepos="bc" style="filled,rounded" label="Person\nConsumer" tooltip="Consumer: The recipient of the email notification being sent." ];
