                "System Timer" [ shape="rectangle" height="0.75" width="0.75" fixedsize="true" gradientangle="90" fillcolor="White;0.75:#D8E4BC" color="#D8E4BC" fontname="Calibri" fontsize="10" style="filled,rounded" fontcolor="black" labelloc="top" image="images/event.png" imagescale="False" imagepos="bc" label="Event\nSystem\nTimer" tooltip="System Timer: Runs once per minute to signal Consumer Notifications to check for tasks." ];
                "Notification Queue" [ labelloc="top" shape="rectangle" height="0.625" width="0.75" fixedsize="True" fillcolor="transparent" color="transparent" penwidth="0.5" fontname="Calibri" fontsize="10" fontcolor="black" image="images/queue.png" imagescale="False" imagepos="bc" style="filled" label="Notification\nQueue" tooltip="Notification Queue: Stores and sequences notification messages until they are ready for delivery, ensuring they are processed in the correct order and at the appropriate time." ];
                "Dead Letter Queue" [ labelloc="top" shape="rectangle" height="0.625" width="0.75" fixedsize="True" fillcolor="transparent" color="transparent" penwidth="0.5" fontname="Calibri" fontsize="10" fontcolor="black" image="images/queue.png" imagescale="False" imagepos="bc" style="filled" label="Dead\nLetter\nQueue" tooltip="Dead Letter Queue: Stores notification messages that could not be transmitted to the Marketing CRM, preserving them for inspection, retry, or remediation." ];
                "App Log Files" [ shape="rectangle" height="0.625" width="0.75" fixedsize="true" fillcolor="transparent" color="transparent" fontcolor="black" fontname="Calibri" fontsize="10" style="filled" penwidth="0.5" image="images/file.png" imagescale="False" imagepos="bc" labelloc="top" label="App Log\nFiles" tooltip="App Log Files: Server‑generated log files containing diagnostic messages recorded during technical faults or unexpected application behavior." ];
                "Notification History" [ shape="rectangle" height="0.625" width="0.75" fixedsize="true" fillcolor="transparent" color="transparent" fontcolor="black" fontname="Calibri" fontsize="10" style="filled" penwidth="0.5" image="images/database.png" imagescale="False" imagepos="bc" labelloc="top" label="Notification\nHistory" tooltip="Notification History: Retains request tracking numbers and delivery histories to support auditability, traceability, and compliance." ];
                "Email Template Catalog" [ shape="rectangle" height="0.625" width="0.75" fixedsize="true" fillcolor="transparent" color="transparent" fontcolor="black" fontname="Calibri" fontsize="10" style="filled" penwidth="0.5" image="images/database.png" imagescale="False" imagepos="bc" labelloc="top" label="Email\nTemplate\nCatalog" tooltip="Email Template Catalog: Catalogs the names of email templates maintained within the Marketing CRM for campaign and notification use." ];
                "Note 1" [ shape="note" fixedsize="false" fillcolor="LemonChiffon1" color="DarkGoldenrod1" penwidth="0.5" fontname="Calibri" fontsize="12" style="filled" label="Business application uses the\lConsumer Notifications\lapplication to send\lgraphics-rich emails to\lcustomers.\l" tooltip="Note 1" ];
                "Note 2" [ shape="note" fixedsize="false" fillcolor="LemonChiffon1" color="DarkGoldenrod1" penwidth="0.5" fontname="Calibri" fontsize="12" style="filled" label="Four delivery attempts are\lmade. After four failures, the\lrequest moves to the Dead\lLetter Queue of manual\lresolution.\l" tooltip="Note 2" ];
